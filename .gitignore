# 依赖
node_modules/

# 构建产物
out/
dist/
*.tsbuildinfo

# 便携工具链（本地测试用，不入库）
.tools/

# 运行时数据（真实用户数据库/提交历史/练习记录绝不入库；
# 应用运行时数据库位于 %APPDATA%/CuinCodeBench，项目外）
*.db
*.db-wal
*.db-shm
dev-data/

# 环境变量（如未来需要：仅允许 .env.example 模板入库）
.env
.env.*
!.env.example

# 测试与覆盖率
coverage/

# 日志与临时目录
*.log
logs/
tmp/
temp/
.cache/

# 编辑器个人配置
.vscode/
.idea/

# 系统文件
Thumbs.db
desktop.ini
.DS_Store

# E2E 运行时数据目录
.e2e-data/

# v1.3 native launcher（源码入库 native/ccb-launcher/，产物不入库）
native/bin/
